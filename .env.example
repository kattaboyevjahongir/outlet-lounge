# Copy these names into Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. The real ones live only in Vercel (and your own .env.local).

# --- public (safe to expose; row level security protects the data) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- secret (server only) — used from phase 3 on ---
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # optional — normally the private `telegram` setting in the database
TELEGRAM_WEBHOOK_SECRET=

# --- optional ---
SITE_URL=https://outlet-lounge.vercel.app   # used by scripts/telegram-setup.mjs
